# ============================================================
# M-TRANS LOGISTICS — Server Environment Variables
# Bu faylı kopyalayaraq .env adı ilə saxlayın və
# real dəyərləri daxil edin. `mock...` dəyərləri saxlanılan
# hər inteqrasiya avtomatik MOCK rejimdə işləyir (bax config/env.js).
# ============================================================

# ── Server ─────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
# Vergüllə ayrılmış siyahı. Production-da localhost SAXLANILMAMALIDIR.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
BODY_LIMIT=64kb
TRUST_PROXY=loopback

# ── PostgreSQL (məcburidir — mərkəzi anbar) ─────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/truck_parts_db
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_SSL=false
DB_RETRY_INTERVAL_MS=15000

# ── Xarici SQL Server (Read-Only) ───────────────────────────────
# Boş qalarsa sinxronizasiya MOCK data ilə işləyir.
# MS SQL Server tələb olunur (npm paketi: `mssql`).
EXTERNAL_DB_HOST=sql.sirketiniz.local
EXTERNAL_DB_PORT=1433
EXTERNAL_DB_NAME=Warehouse1C
EXTERNAL_DB_USER=readonly_user
EXTERNAL_DB_PASSWORD=mock_pass
# Şirkət daxili şəbəkədə çox vaxt özü-imzalı sertifikat olur:
EXTERNAL_DB_ENCRYPT=true
EXTERNAL_DB_TRUST_SERVER_CERTIFICATE=false
# Sxeminizə uyğun cədvəl/görünüş adı (default sorğuda istifadə olunur):
EXTERNAL_DB_PRODUCTS_TABLE=dbo.Products
# Tam sərbəst SELECT lazım olarsa (JOIN, fərqli sütun adları) — boş
# buraxılsa EXTERNAL_DB_PRODUCTS_TABLE əsasında default sorğu qurulur.
# Sütunlar bu adlarla alias edilməlidir: external_id, oem_code,
# article_no, brand, category, title, description, price, currency,
# stock_quantity, warehouse.
# EXTERNAL_DB_PRODUCTS_QUERY=SELECT ...
EXTERNAL_DB_PAGE_SIZE=2000
EXTERNAL_DB_MAX_PAGES=200
EXTERNAL_DB_POOL_MAX=5
EXTERNAL_DB_CONNECT_TIMEOUT_MS=15000
EXTERNAL_DB_REQUEST_TIMEOUT_MS=30000

# ── TecDoc API ───────────────────────────────────────────────────
TECDOC_API_KEY=mock_tecdoc_key
TECDOC_BASE_URL=https://webservice.tecalliance.services/pegasus-3-0/services/TecdocToCatDLB.jsonEndpoint
TECDOC_PROVIDER_ID=0
TECDOC_LANG=az
TECDOC_COUNTRY=AZ
TECDOC_CACHE_TTL_HOURS=720

# ── Google Gemini AI ─────────────────────────────────────────────
GEMINI_API_KEY=mock_gemini_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
GEMINI_MAX_OUTPUT_TOKENS=2400
GEMINI_TEMPERATURE=0.4
# GEMINI_THINKING_BUDGET=   (boş buraxın — thinkingConfig göndərilməz)
CHAT_MAX_HISTORY_TURNS=8
CHAT_MAX_MESSAGE_CHARS=1500

# ── Xarici DB sinxronizasiyası (cron) ─────────────────────────────
SYNC_CRON=*/15 * * * *
SYNC_TIMEZONE=Asia/Baku
SYNC_ENABLED=true
SYNC_RUN_ON_BOOT=true
SYNC_BATCH_SIZE=200

# ── Admin (manual sinxronizasiya tetiklənməsi) ───────────────────
# Boş buraxılsa /api/admin/* route-ları TAM bağlıdır (fail-closed).
# Minimum 32 simvol tövsiyə olunur (məs: `openssl rand -hex 32`).
ADMIN_API_TOKEN=

# ── Rate limiting ─────────────────────────────────────────────────
RL_GLOBAL_MAX=600
RL_SEARCH_MAX=200
RL_CHAT_MAX=60
RL_ADMIN_MAX=10

# ── Loglama ───────────────────────────────────────────────────────
LOG_LEVEL=debug
